HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=*
# LLM 网关（OpenAI 兼容，对齐旧版 drr-service-debug 的 runway）：只要填了 LLM_API_KEY 就启用；endpoint / model 不填用下面的默认值
LLM_API_KEY=
LLM_ENDPOINT=https://runway.devops.rednote.life/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=8192
# 鉴权头：api-key（runway，默认）| authorization（Authorization: Bearer）
LLM_AUTH_HEADER=api-key
# 是否发 response_format=json_object；旧版不发，确认网关支持后再开
LLM_JSON_MODE=false
# ① 知识预注入：容量 L（硬上界）/ 停止阈值 τ（Δ/token）
PREINJECT_TOKEN_BUDGET=2000
PREINJECT_TAU=0.001
PREINJECT_PAIR_MIN_SIM=0.3
# 路 1：context-query（SSO：优先透传请求 Cookie，其次 CONTEXT_QUERY_COOKIE）
CONTEXT_QUERY_ENABLED=true
CONTEXT_QUERY_BASE_URL=https://context-query.devops.xiaohongshu.com
CONTEXT_QUERY_SOURCE_TYPES=knowledge
CONTEXT_QUERY_COOKIE=
CONTEXT_QUERY_OWNER=
# ③ 规划：A_max 缺省值（前端输入优先）/ 候选图个数 K / 评分权重 Score = α·覆盖度 + β·并行度 − γ·Agent 消耗
MAX_PARALLEL_AGENTS=4
PLANNER_NUM_CANDIDATES=3
PLANNER_LLM_EXTRA=2
PLANNER_LLM_LEVEL_ENABLED=true
# 入口定级：知识必须指明 BI 资产才算「已指明资产」；默认 false：知识指明的任何数据源资产（含明细表）就算
PLANNER_REQUIRE_BI_ASSET=false
PLANNER_W_COVERAGE=0.6
PLANNER_W_PARALLEL=0.2
PLANNER_W_COST=0.2
# ④ 检索通道（bi / graph / knowledge）；默认关闭回退 fakes
RECALL_CHANNELS_ENABLED=false
# 执行失败后最多回滚重试次数
EXEC_MAX_ATTEMPTS=3
# 已验证 pair 存储：memory | jsonl
PAIR_STORE_BACKEND=jsonl
PAIR_STORE_PATH=data/history_queries.jsonl
# ④ 角色由 LLM 驱动（改写 query / 评估结果 / 自评是否接活 / 撰写求助问题）：默认关闭；MAX_CALLS 是整次召回的总预算；LLM_MAX_WORKERS 是 LLM 客户端独立线程池
RECALL_LLM_ENABLED=false
RECALL_LLM_MAX_CALLS=40
RECALL_LLM_CONCURRENCY=8
RECALL_LLM_TIMEOUT_SEC=30
# ④ 召回多少条由 LLM 决定（范围）；评估后觉得不够，最多补召回几次
RECALL_MIN_LIMIT=3
RECALL_MAX_LIMIT=30
RECALL_MAX_SUPPLEMENTS=2
LLM_MAX_WORKERS=16
# ④ 协作：定向询问阈值 / 广播揭榜线 / 被询问角色婉拒线 / 采纳所需证据卡置信度 / 等待他人探查的最长秒数 / 画像质量 EMA 步长
COLLAB_DIRECT_THRESHOLD=0.6
COLLAB_VOLUNTEER_MIN=0.4
COLLAB_ACCEPT_MIN=0.3
COLLAB_ADOPT_MIN_CONF=0.3
COLLAB_WAIT_SEC=5
COLLAB_QUALITY_ALPHA=0.2
# 角色能力画像注册表：memory | json
ROLE_PROFILE_STORE_BACKEND=json
ROLE_PROFILE_STORE_PATH=data/role_profiles.json
# ④ 发现驱动的转交：开关 / 最大跳数 / 一张证据卡最多转交几个发现 / 一次召回的总预算
COLLAB_HANDOFF_ENABLED=true
COLLAB_HANDOFF_MAX_DEPTH=2
COLLAB_HANDOFF_FANOUT=2
COLLAB_HANDOFF_MAX_TOTAL=12
