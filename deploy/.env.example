# docker compose 读取的变量（复制为 .env）。都有默认值，按需修改。

# ── HTTPS 模式（docker-compose.yml）──
DOMAIN=demo.example.com        # A 记录指向本服务器；本机试跑用 localhost（Caddy 自签证书）；无证书条件先用 :80

# ── HTTP 模式（docker-compose.http.yml）──
APP_PORT=8080                  # 宿主机端口
APP_BIND=0.0.0.0               # 只想本机 / 前面自己放反向代理时改成 127.0.0.1

# ── 镜像 ──
DD_IMAGE=dd-demo:latest        # 本机构建、`docker save` 拷过去时的镜像名；推到私有仓库就改成仓库地址

# ── 网络受限（只在服务器上构建镜像时才需要）──
# PYTHON_IMAGE=<镜像站>/library/python:3.11-slim
# CADDY_IMAGE=<镜像站>/library/caddy:2
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
