# 外网演示：复制为 demo.env 后按需修改（install.sh 会自动复制）。这里没有任何密钥——演示模式只用假数据，不连内网、不用 LLM。
# 镜像里已经内置了下面这些默认值，不改也能跑。
DEMO_MODE=true

# 前端页面与 API 同源，不需要跨域
CORS_ORIGINS=

# 英文种子历史（只读：公开接口写入的配对只存内存，重启恢复）
PAIR_STORE_BACKEND=jsonl_ro
PAIR_STORE_PATH=/app/data/demo_history.jsonl
UI_HTML_PATH=/app/ui/index.html

# 每个客户端每分钟允许的 /api/stage* 等请求数、突发容量（在反向代理之后按 X-Forwarded-For 最右一个地址识别）
DEMO_RATE_LIMIT_PER_MIN=30
DEMO_RATE_BURST=15

# 前面有可信反向代理（docker-compose.yml 里的 Caddy）时为 true；docker-compose.http.yml 会自动覆盖成 false
DEMO_TRUST_PROXY=true

LOG_LEVEL=info
